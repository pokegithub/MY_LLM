{
  "schema": "lightning_ai_free_credit_gpu_policy_v1",
  "credit_budget_max": 15,
  "require_free_credit_only": true,
  "allow_paid_overage": false,
  "require_credit_balance_check": true,
  "require_manual_execute_confirmation": true,
  "default_mode": "dry_run",
  "hard_stop_on_unknown_price": true,
  "hard_stop_on_unknown_credit_balance": true,
  "max_runtime_minutes_default": 30,
  "max_runtime_minutes_hard_limit": 60,
  "gpu_selection_rule": "choose_cheapest_compatible_gpu_after_price_and_credit_confirmation_not_absolute_cheapest",
  "compatible_gpu_requirements": {
    "cuda_required_for_gpu_smoke": true,
    "minimum_vram_gb_for_candidate_readiness_smoke": 8,
    "prefer_lowest_cost_gpu_that_meets_vram_and_cuda_requirements": true,
    "price_source": "manual_lightning_ui_or_authenticated_cli_required"
  },
  "allowed_task_classes": [
    "backend_smoke",
    "candidate_readiness_smoke",
    "repo_assist_eval",
    "hidden_eval_seed_run",
    "trajectory_quality_audit"
  ],
  "disallowed_task_classes": [
    "train",
    "sft",
    "dpo",
    "distill",
    "improve",
    "rlvr",
    "full_bakeoff",
    "production_serving"
  ],
  "allowed_commands": [
    "python run.py status",
    "python run.py deps",
    "python run.py compile-source",
    "python run.py repo-assist-eval",
    "python run.py hidden-eval-seed-run",
    "python run.py trajectory-quality-audit",
    "python run.py candidate-readiness-smoke",
    "python run.py agent-backend-smoke"
  ],
  "blocked_commands": [
    "python run.py train",
    "python run.py sft",
    "python run.py dpo",
    "python run.py distill",
    "python run.py improve",
    "python run.py full",
    "python run.py eval-harness",
    "python run.py benchmark-harness",
    "python run.py deployment-info --serve"
  ],
  "credential_policy": {
    "manual_login_required": true,
    "store_passwords": false,
    "store_tokens": false,
    "print_secrets": false,
    "allowed_secret_transport": "environment_variables_or_lightning_secret_system_only"
  },
  "quality_claim": "none"
}
